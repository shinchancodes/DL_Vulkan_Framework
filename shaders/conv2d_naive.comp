#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(std430, binding = 0) readonly  buffer InputBuf  { float inData[];  };
layout(std430, binding = 1) readonly  buffer KernelBuf { float kernel[];  };
layout(std430, binding = 2) readonly  buffer BiasBuf   { float bias[];    };
layout(std430, binding = 3) writeonly buffer OutputBuf { float outData[]; };

layout(push_constant) uniform PushConsts {
    int imgW;
    int imgH;
    int inC;
    int outC;
    int kW;
    int kH;
    int padW;
    int padH;
    int strideW;
    int strideH;
} pc;

int outW() { return (pc.imgW + 2 * pc.padW - pc.kW) / pc.strideW + 1; }
int outH() { return (pc.imgH + 2 * pc.padH - pc.kH) / pc.strideH + 1; }

int inIdx(int h, int w, int c)          { return (h * pc.imgW + w) * pc.inC + c; }
int kIdx(int kh, int kw, int ic, int oc){ return ((kh * pc.kW + kw) * pc.inC + ic) * pc.outC + oc; }
int outIdx(int h, int w, int c)         { return (h * outW() + w) * pc.outC + c; }

void main() {
    int ox = int(gl_GlobalInvocationID.x);
    int oy = int(gl_GlobalInvocationID.y);
    int oc = int(gl_GlobalInvocationID.z);

    if (ox >= outW() || oy >= outH() || oc >= pc.outC) return;

    float acc = bias[oc];  // initialise accumulator with bias

    for (int ic = 0; ic < pc.inC; ++ic) {
        for (int kh = 0; kh < pc.kH; ++kh) {
            for (int kw = 0; kw < pc.kW; ++kw) {
                int ih = oy * pc.strideH - pc.padH + kh;
                int iw = ox * pc.strideW - pc.padW + kw;
                if (ih < 0 || ih >= pc.imgH || iw < 0 || iw >= pc.imgW)
                    continue;
                acc += inData[inIdx(ih, iw, ic)] * kernel[kIdx(kh, kw, ic, oc)];
            }
        }
    }

    outData[outIdx(oy, ox, oc)] = acc;
}